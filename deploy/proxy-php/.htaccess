# SISTRA — tampilan (HTML/CSS/JS) dilayani dari disk server ini; hanya /api/ diteruskan ke server aplikasi
Options -Indexes
DirectoryIndex index.html
RewriteEngine On

# Paksa HTTPS (kecuali validasi sertifikat AutoSSL)
RewriteCond %{HTTPS} off
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Purwarupa UI/UX (gerbang login di prototipe/index.php)
RewriteRule ^prototipe$ /prototipe/ [R=301,L]
RewriteRule ^prototipe/ - [L]

# API → proxy PHP ke server aplikasi
RewriteRule ^sistra-proxy\.php$ - [L]
RewriteRule ^api/ sistra-proxy.php [L,QSA]

# Berkas yang ada di disk (index.html, assets/*) dilayani langsung
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Rute SPA lainnya → index.html
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteRule ^ index.html [L]

<FilesMatch "^(php\.ini|\.htaccess|error_log)$">
    Require all denied
</FilesMatch>
